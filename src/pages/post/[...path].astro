---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Partial from '../../components/Partial.astro';
import { buildToc, tocHtml } from '../../plugins/toc/toc';
import { getPosts, postPath, postDescription, formatDate, stateOf, type Post } from '../../lib/posts';
import { ogImagePath } from '../../og/render';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    // "/post/2025/01/29/gomi/" -> "2025/01/29/gomi"
    params: { path: postPath(post).replace(/^\/post\/|\/$/g, '') },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings, remarkPluginFrontmatter } = await render(post);
// Left out of the table of contents: "footnote-label", the hidden heading
// remark-rehype puts before footnotes, and the headings of past versions
// (src/plugins/revision/)
const hidden = new Set<string>(['footnote-label', ...(remarkPluginFrontmatter.revisionHiddenHeadings ?? [])]);
const toc = post.data.toc ? tocHtml(buildToc(headings.filter((h) => !hidden.has(h.slug)))) : '';
// the newest update the post has (src/plugins/revision/), when later than its date
const updated: string | undefined =
  remarkPluginFrontmatter.updated > formatDate(post.data.date) ? remarkPluginFrontmatter.updated : undefined;
// "content/post/2026/foo/index.mdx" -> "content/post/2026/foo", for <Partial>
Astro.locals.postDir = post.filePath!.replace(/\/[^/]+$/, '');
---

<Base title={post.data.title} description={postDescription(post)} published={post.data.date} modified={updated} image={ogImagePath(postPath(post))}>
  <!--
    The table of contents sits in the empty space right of the content column
    (absolutely positioned, so the column does not move) and follows the
    scroll. Below xl there is no room for it; it sits at the top of the post
    instead, as a numbered list, always open.
  -->
  <article class="relative">
    {
      toc && (
        <aside class="absolute top-0 left-full ml-12 hidden h-full w-56 xl:block">
          <nav class="toc sticky top-16" aria-label="目次">
            <p class="toc-label">目次</p>
            <Fragment set:html={toc} />
          </nav>
        </aside>
      )
    }
    <header class="mb-10">
      <h1 class="text-xl leading-snug font-semibold text-heading md:text-2xl">
        {post.data.title}
      </h1>
      <p class="mt-2 text-sm text-subtle tabular-nums">
        <time datetime={post.data.date} class="font-mono">{formatDate(post.data.date)}</time>
        {
          updated && (
            <span class="ml-2">
              (<time datetime={updated} class="font-mono">{updated}</time> 更新)
            </span>
          )
        }
        {stateOf(post) !== 'published' && <span class="ml-2 text-[10px] font-semibold tracking-wider text-draft uppercase">{stateOf(post)}</span>}
      </p>
    </header>
    {
      toc && (
        <nav class="toc toc-chapters xl:hidden" aria-label="目次">
          <p class="toc-label">目次</p>
          <Fragment set:html={toc} />
        </nav>
      )
    }
    <div class="article">
      <Content components={{ Partial }} />
    </div>
  </article>
</Base>

<script>
  import { initGalleries } from '../../plugins/gallery/client';
  import { initCarousels } from '../../plugins/carousel/client';
  import { initLightbox } from '../../plugins/lightbox/client';
  import { initToc } from '../../plugins/toc/client';
  import { initTweets } from '../../plugins/embed/client';
  import { initMermaid } from '../../plugins/mermaid/client';
  import { initCodeBlocks } from '../../plugins/code-block/client';
  initGalleries();
  initCarousels();
  initLightbox();
  initToc();
  initTweets();
  initMermaid();
  initCodeBlocks(document, { label: 'コピー', copiedLabel: 'コピーしました' });
</script>
