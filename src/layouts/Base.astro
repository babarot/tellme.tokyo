---
import '../styles/global.css';
import { Image } from 'astro:assets';
import me from '../assets/me.jpg';
import { config } from '../config';
import { showDrafts } from '../lib/posts';
import { family, fontUrl } from '../fonts/subset';
import Logo from '../icons/logo.svg';
import LogoDark from '../icons/logo-dark.svg';
import GitHub from '../icons/github.svg';
import X from '../icons/x.svg';
import Rss from '../icons/rss.svg';

interface Props {
  title?: string;
  description?: string;
  /** a post's date (YYYY-MM-DD...), which also makes the page an article */
  published?: string;
  /** path of the page's Open Graph image (src/lib/og.ts); the site's by default */
  image?: string;
}

const { title, description = 'babarot のブログ', published, image = '/og.png' } = Astro.props;
const siteName = 'tellme.tokyo';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// GitHub and X are filled brand marks (Simple Icons) drawn edge to edge; RSS is
// a stroked icon (Lucide) with padding. X fills its box the most, so it is set
// smaller to look the same size as the others.
const links = [
  { href: 'https://github.com/babarot', label: 'GitHub', Icon: GitHub, iconClass: 'size-4 fill-current' },
  { href: 'https://x.com/b4b4r07', label: 'X', Icon: X, iconClass: 'size-[14px] fill-current' },
  { href: '/feed.xml', label: 'RSS', Icon: Rss, iconClass: 'size-4' },
];
---

<!doctype html>
<html lang="ja" data-theme={config.theme} data-theme-switch={showDrafts ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Follow the OS setting; ?scheme=dark|light forces one (for checking both).
      // In dev and previews, ?theme=<name> swaps the theme (color set) as well.
      (() => {
        const params = new URLSearchParams(location.search);
        const root = document.documentElement;
        if (root.hasAttribute('data-theme-switch') && params.get('theme')) {
          root.dataset.theme = params.get('theme');
        }
        const forced = params.get('scheme');
        const media = matchMedia('(prefers-color-scheme: dark)');
        const apply = () =>
          document.documentElement.classList.toggle('dark', forced ? forced === 'dark' : media.matches);
        apply();
        media.addEventListener('change', apply);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      // Builds that show drafts (dev, previews of branches) stay out of search engines
      showDrafts && <meta name="robots" content="noindex" />
    }
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    {published && <meta property="article:published_time" content={published} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@b4b4r07" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/feed.xml" />
    {
      /* The body font for readers without 游ゴシック (Macs, iPhones), served
         from the site and cut down to its characters (src/fonts/). The build
         replaces these URLs with the subset files'. No format(): dev serves
         the whole TrueType font. */
    }
    <style is:inline set:html={`
      @font-face { font-family: '${family}'; src: url('${fontUrl(400)}'); font-weight: 400; font-display: swap; }
      @font-face { font-family: '${family}'; src: url('${fontUrl(700)}'); font-weight: 700; font-display: swap; }
    `} />
    <script is:inline define:vars={{ fonts: [fontUrl(400), fontUrl(700)] }}>
      // Preload the body font only where it will be used: a reader with
      // 游ゴシック (Windows) never downloads it. 游ゴシック is there when text in
      // it does not measure the same as the fallback alone.
      (() => {
        const ctx = document.createElement('canvas').getContext('2d');
        const width = (font) => {
          ctx.font = `32px ${font}`;
          return ctx.measureText('游ゴシック abc').width;
        };
        if (width("'游ゴシック', YuGothic, monospace") !== width('monospace')) return;
        for (const href of fonts) {
          const link = Object.assign(document.createElement('link'), { rel: 'preload', as: 'font', type: 'font/woff2', href });
          link.crossOrigin = 'anonymous';
          document.head.append(link);
        }
      })();
    </script>
  </head>
  <body class="bg-page font-sans text-ink antialiased">
    <div class="mx-auto max-w-[42.5rem] px-4 pt-10 pb-32 md:pt-16">
      <header class="mb-16">
        <a href="/" class="inline-flex items-center gap-2 font-bold text-brand transition-opacity hover:opacity-70">
          <Logo class="size-6 dark:hidden" aria-hidden="true" />
          <LogoDark class="hidden size-6 dark:block" aria-hidden="true" />
          tellme.tokyo
        </a>
      </header>
      <main>
        <slot />
      </main>
      <!-- One faint row: © babarot | GitHub X RSS. Each link darkens on hover. -->
      <footer class="mt-24 flex items-center gap-3 text-sm text-faint">
        <span>© babarot</span>
        <span class="h-3.5 w-px bg-current" aria-hidden="true"></span>
        <ul class="flex items-center gap-3">
          <li>
            <!-- babarot.me: the face, grey and faint like the icons, in color on hover -->
            <a href="https://babarot.me" aria-label="About" title="About" class="flex items-center">
              <Image
                src={me}
                alt=""
                width={16}
                height={16}
                densities={[1, 2]}
                class="size-4 rounded-full opacity-50 grayscale transition hover:opacity-100 hover:grayscale-0"
              />
            </a>
          </li>
          {
            links.map(({ href, label, Icon, iconClass }) => (
              <li>
                <a href={href} aria-label={label} title={label} class="flex items-center transition-colors hover:text-faint-hover">
                  <Icon class={iconClass} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </footer>
    </div>
  </body>
</html>
